{
  "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "client": {
      "root": "client/client",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/records", "destination": { "service": "app" } },
    { "source": "/records/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
